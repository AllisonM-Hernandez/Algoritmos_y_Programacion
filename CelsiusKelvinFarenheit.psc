// Realizar un algoritmo en pseudocodigo para convertir grados Celsius a grados Kelvin y Fahrenheit.
Algoritmo CelsiusKelvinFarenheit
	Definir Celsius Como Real
	Escribir 'Ingrese la temperatura en Celsius'
	Leer Celsius
	
	K <- Celsius + 273.15
	F <- (Celsius * 9/5) + 32
	
	Escribir "La temperatura en grados Kelvin es:" ,K, " Kelvin"
	Escribir "La temperatura en grados Farenheit es:" ,F, " Farenheit"
FinAlgoritmo
